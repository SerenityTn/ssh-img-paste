# Copy this template to either:
#   ~/.config/vps-img-paste/profiles/default.env   # named-profile config
#   ~/.config/vps-img-paste.env                    # legacy config (still supported)
# Keep real config files OUT of git.
#
# Profile files are parsed without executing shell. Use literal KEY="value"
# assignments for the supported fields below; do not use ${VAR}, $(commands),
# backticks, source, functions, or other shell logic for these values. Manual
# files with extra unsupported statements can still be used/tested by the CLI
# if the supported values are literal, but the GUI will show them read-only.

# Optional display label for menus/profile listings. Defaults to the profile id.
# GUI-managed profiles keep the id in the filename (for example work.env);
# rename the profile instead of editing the filename while the app is running.
# VPS_PROFILE_LABEL="My VPS"

# SSH target (user@host or an ssh_config alias). The app never stores or edits
# SSH passwords, private keys, ports, ProxyJump/jump hosts, or other SSH
# options; keep those in ~/.ssh/config and use the alias here. Test Connection
# uses noninteractive BatchMode SSH.
VPS_HOST="user@your-vps-host"

# Absolute home dir on the remote host — used to build the path you paste.
VPS_REMOTE_HOME="/home/user"

# Remote upload folder, relative to the SSH login dir. Deleting a local profile
# never deletes uploaded files from this remote folder.
# VPS_REMOTE_DIR="img-uploads"

# When the clipboard has no image, how the icon captures a screenshot:
#   region = drag to select a screen area (default)   full = whole main display
# This is an advanced GUI-managed field.
# VPS_SHOT_MODE="region"

# Path to pngpaste if not the Apple-Silicon Homebrew default.
# PNGPASTE="/opt/homebrew/bin/pngpaste"

# After an upload the VPS path is placed on the clipboard so you can paste it
# into your SSH session; this many seconds later the previous clipboard
# (image/text) is restored so the link never lingers. Set 0 to keep the path.
# This is an advanced GUI-managed field.
# VPS_CLIP_RESTORE_SECONDS="60"
