#!/usr/bin/env bash
# Send an image (clipboard, or a screenshot) to a remote host over SSH, and
# manage the uploaded images.
#
# Subcommands:
#   (none) | upload   Upload the clipboard image; if the clipboard has no image,
#                     capture per SSH_SHOT_MODE (default: region selection).
#   region            Drag to select a screen region, then upload it.
#   full              Capture the full main display, then upload it.
#   list              Print "SIZE<TAB>NAME" for each uploaded image, newest first.
#   fetch NAME        Download NAME to a temp dir and print its local path.
#   clean             Delete all uploaded images on the host; print the count.
#   profiles          Print tab-separated profile rows: marker, id, label, host.
#   profile current   Print the selected profile ID.
#   profile use NAME  Persistently select NAME as the active profile.
#   profile inspect NAME
#   profile create NAME --label LABEL --host HOST --remote-home PATH --remote-dir DIR [--shot-mode region|full] [--restore-seconds N]
#   profile update NAME [same field flags]
#   profile rename OLD NEW
#   profile delete NAME [--switch-to OTHER]
#   profile test NAME
#
# Profiles live in ~/.config/ssh-img-paste/profiles/NAME.env and use SSH_* keys.
set -euo pipefail

# --- config ------------------------------------------------------------------
CONFIG_BASE="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_ROOT="${SSH_IMG_PASTE_CONFIG_DIR:-$CONFIG_BASE/ssh-img-paste}"
PROFILES_DIR="$CONFIG_ROOT/profiles"
ACTIVE_FILE="$CONFIG_ROOT/active-profile"
REQUESTED_PROFILE=""
PROFILE_LABEL=""
PROFILE_KIND=""
PROFILE_PATH=""
PROFILE_EDITABLE="false"
PROFILE_PARSE_ERROR=""
PROFILE_ID=""
SSH=""
REMOTE_HOME=""
REMOTE_DIR=""

usage() {
  echo "usage: ssh-img-paste [--profile NAME] [upload|region|full|list|fetch NAME|clean|profiles|profile [current|use|inspect|create|update|rename|delete|test] ...]" >&2
}

profile_usage() {
  echo "usage: ssh-img-paste profile [current|use NAME|inspect NAME|create NAME --label LABEL --host HOST --remote-home PATH --remote-dir DIR [--shot-mode region|full] [--restore-seconds N]|update NAME [same flags]|rename OLD NEW|delete NAME [--switch-to OTHER]|test NAME]" >&2
}

notify() {
  [ "${SSH_IMG_PASTE_SUPPRESS_NOTIFICATIONS:-0}" = 1 ] && return 0
  osascript - "$1" "$2" <<'OSA' >/dev/null 2>&1 || true
on run argv
  set theSubtitle to item 1 of argv
  set theMessage to item 2 of argv
  display notification theMessage with title "SSH Image Paste" subtitle theSubtitle
end run
OSA
}

die() {
  local status="$1"
  shift
  echo "✗ $*" >&2
  exit "$status"
}

valid_profile_id() {
  case "$1" in
    ""|*[!A-Za-z0-9_-]*|[!A-Za-z0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

has_control() {
  case "$1" in
    *[$'\001'-$'\037'$'\177']*) return 0 ;;
    *) return 1 ;;
  esac
}

reject_control() {
  local name="$1" value="$2"
  if has_control "$value"; then
    echo "✗ Invalid $name: control characters are not allowed" >&2
    return 64
  fi
  return 0
}

validate_id_or_die() {
  local id="$1"
  valid_profile_id "$id" || die 64 "Invalid profile: $id"
}

reject_shell_metas() {
  case "$1" in
    *[\'\"\`\$\;\&\|\<\>\(\)\{\}\[\]\*\?\\]* ) return 0 ;;
    *) return 1 ;;
  esac
}

validate_host() {
  local value="$1"
  reject_control host "$value" || return $?
  case "$value" in
    ""|-*|*[[:space:]]*) echo "✗ Invalid host: must be a non-option SSH target without whitespace" >&2; return 64 ;;
  esac
  if reject_shell_metas "$value"; then
    echo "✗ Invalid host: shell metacharacters are not allowed" >&2
    return 64
  fi
  return 0
}

validate_abs_path() {
  local name="$1" value="$2"
  reject_control "$name" "$value" || return $?
  case "$value" in
    /*) ;;
    *) echo "✗ Invalid $name: must be an absolute path" >&2; return 64 ;;
  esac
  case "$value" in
    */../*|*/..|/..|*//*) echo "✗ Invalid $name: traversal is not allowed" >&2; return 64 ;;
  esac
  if reject_shell_metas "$value"; then
    echo "✗ Invalid $name: shell metacharacters are not allowed" >&2
    return 64
  fi
  case "$value" in
    *[!A-Za-z0-9._/-]*) echo "✗ Invalid $name: unsafe path characters" >&2; return 64 ;;
  esac
  return 0
}

validate_remote_dir() {
  local value="$1"
  reject_control remote_dir "$value" || return $?
  case "$value" in
    ""|/*|-*) echo "✗ Invalid remote_dir: must be a safe relative path" >&2; return 64 ;;
  esac
  case "$value" in
    .|..|../*|*/../*|*/..|*//*) echo "✗ Invalid remote_dir: traversal is not allowed" >&2; return 64 ;;
  esac
  if reject_shell_metas "$value"; then
    echo "✗ Invalid remote_dir: shell metacharacters are not allowed" >&2
    return 64
  fi
  case "$value" in
    *[!A-Za-z0-9._/-]*) echo "✗ Invalid remote_dir: unsafe path characters" >&2; return 64 ;;
  esac
  return 0
}

validate_shot_mode() {
  local value="$1"
  reject_control shot_mode "$value" || return $?
  case "$value" in region|full) return 0 ;; esac
  echo "✗ Invalid shot_mode: expected region or full" >&2
  return 64
}

validate_restore_seconds() {
  local value="$1" normalized max="86400"
  reject_control restore_seconds "$value" || return $?
  case "$value" in ""|*[!0-9]*) echo "✗ Invalid restore_seconds: expected a non-negative integer" >&2; return 64 ;; esac
  normalized="$value"
  while [ "${normalized#0}" != "$normalized" ]; do
    normalized="${normalized#0}"
  done
  [ -n "$normalized" ] || normalized=0
  if [ "${#normalized}" -gt "${#max}" ]; then
    echo "✗ Invalid restore_seconds: expected an integer between 0 and 86400" >&2
    return 64
  fi
  # Intentional string comparison after equal-length decimal normalization.
  # shellcheck disable=SC2071
  if [ "${#normalized}" -eq "${#max}" ] && [[ "$normalized" > "$max" ]]; then
    echo "✗ Invalid restore_seconds: expected an integer between 0 and 86400" >&2
    return 64
  fi
  return 0
}

validate_fetch_name() {
  local value="$1"
  reject_control fetch_name "$value" || return $?
  case "$value" in
    ""|-*|*[[:space:]]*|*/*|*..*) echo "✗ Invalid fetch name: expected a safe uploaded .png basename" >&2; return 64 ;;
  esac
  case "$value" in
    *.png) ;;
    *) echo "✗ Invalid fetch name: expected a safe uploaded .png basename" >&2; return 64 ;;
  esac
  case "$value" in
    *[!A-Za-z0-9._-]*) echo "✗ Invalid fetch name: expected a safe uploaded .png basename" >&2; return 64 ;;
  esac
  return 0
}

validate_label() {
  reject_control label "$1"
}

validate_loaded_profile() {
  validate_label "$PROFILE_LABEL" || return $?
  validate_host "$SSH" || return $?
  validate_abs_path remote_home "$REMOTE_HOME" || return $?
  validate_remote_dir "$REMOTE_DIR" || return $?
  if [ -n "${SSH_SHOT_MODE:-}" ]; then validate_shot_mode "$SSH_SHOT_MODE" || return $?; fi
  if [ -n "${SSH_CLIP_RESTORE_SECONDS:-}" ]; then validate_restore_seconds "$SSH_CLIP_RESTORE_SECONDS" || return $?; fi
  return 0
}

profile_config_path() {
  local id="$1"
  printf '%s/%s.env\n' "$PROFILES_DIR" "$id"
}

profile_exists() {
  local id="$1"
  [ -f "$PROFILES_DIR/$id.env" ]
}

enumerate_profile_ids() {
  local path id
  {
    if [ -d "$PROFILES_DIR" ]; then
      for path in "$PROFILES_DIR"/*.env; do
        [ -f "$path" ] || continue
        id="$(basename "$path" .env)"
        valid_profile_id "$id" || continue
        printf '%s\n' "$id"
      done
    fi
  } | LC_ALL=C sort -u
}

read_active_profile() {
  local id=""
  if [ -f "$ACTIVE_FILE" ]; then
    IFS= read -r id < "$ACTIVE_FILE" || true
  else
    id="$(enumerate_profile_ids | /usr/bin/sed -n '1p')"
  fi
  printf '%s\n' "$id"
}

unescape_double_quoted() {
  local s="$1" out="" c next
  while [ -n "$s" ]; do
    c="${s%${s#?}}"
    s="${s#?}"
    if [ "$c" = "\\" ] && [ -n "$s" ]; then
      next="${s%${s#?}}"
      s="${s#?}"
      case "$next" in
        '"'|'$'|'`'|'\\') out="$out$next" ;;
        *) out="$out\\$next" ;;
      esac
    else
      out="$out$c"
    fi
  done
  printf '%s' "$out"
}

parse_value() {
  local raw="$1" inner
  case "$raw" in
    "\""*"\"")
      inner="${raw#\"}"
      inner="${inner%\"}"
      unescape_double_quoted "$inner"
      return 0
      ;;
    "'"*"'")
      inner="${raw#\'}"
      inner="${inner%\'}"
      case "$inner" in *"'"*) return 1 ;; esac
      printf '%s' "$inner"
      return 0
      ;;
    *[\$\`\;\&\|\<\>\(\)\{\}\[\]\*\?\\\'\"]*) return 1 ;;
    *) printf '%s' "$raw"; return 0 ;;
  esac
}

valid_assignment_key() {
  case "$1" in
    ""|[0-9]*|*[!A-Za-z0-9_]*) return 1 ;;
    *) return 0 ;;
  esac
}

reset_profile_vars() {
  unset SSH_PROFILE_LABEL SSH_HOST SSH_REMOTE_HOME SSH_REMOTE_DIR SSH_SHOT_MODE SSH_CLIP_RESTORE_SECONDS
  PROFILE_LABEL=""
  PROFILE_KIND=""
  PROFILE_PATH=""
  PROFILE_EDITABLE="false"
}

assign_profile_var() {
  local key="$1" value="$2"
  case "$key" in
    SSH_PROFILE_LABEL) SSH_PROFILE_LABEL="$value" ;;
    SSH_HOST) SSH_HOST="$value" ;;
    SSH_REMOTE_HOME) SSH_REMOTE_HOME="$value" ;;
    SSH_REMOTE_DIR) SSH_REMOTE_DIR="$value" ;;
    SSH_SHOT_MODE) SSH_SHOT_MODE="$value" ;;
    SSH_CLIP_RESTORE_SECONDS) SSH_CLIP_RESTORE_SECONDS="$value" ;;
  esac
}

supported_profile_key() {
  case "$1" in
    SSH_PROFILE_LABEL|SSH_HOST|SSH_REMOTE_HOME|SSH_REMOTE_DIR|SSH_SHOT_MODE|SSH_CLIP_RESTORE_SECONDS) return 0 ;;
    *) return 1 ;;
  esac
}

parse_profile_file() {
  local file="$1" line key raw value editable="true"
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ""|\#*) continue ;;
    esac
    case "$line" in
      export\ *) editable="false"; line="${line#export }" ;;
    esac
    case "$line" in
      *=*) key="${line%%=*}"; raw="${line#*=}" ;;
      *) editable="false"; continue ;;
    esac
    if ! valid_assignment_key "$key"; then
      editable="false"
      continue
    fi
    if ! value="$(parse_value "$raw")"; then
      editable="false"
      if supported_profile_key "$key" && [ -z "$PROFILE_PARSE_ERROR" ]; then
        PROFILE_PARSE_ERROR="$key"
      fi
      value=""
    fi
    assign_profile_var "$key" "$value"
  done < "$file"
  PROFILE_EDITABLE="$editable"
}

load_profile() {
  local id="$1" conf
  if [ -z "$id" ]; then
    echo "✗ Not configured. Create a profile in $PROFILES_DIR or use Manage Profiles." >&2
    notify "Not configured" "Create an SSH Image Paste profile"
    return 2
  fi
  valid_profile_id "$id" || {
    echo "✗ Invalid profile: $id" >&2
    return 64
  }

  reset_profile_vars
  PROFILE_PARSE_ERROR=""
  PROFILE_ID="$id"
  conf="$(profile_config_path "$id")"
  PROFILE_PATH="$conf"
  if [ -f "$conf" ]; then
    if [ -L "$conf" ]; then
      echo "✗ Refusing symlinked profile config: $conf" >&2
      return 73
    fi
    parse_profile_file "$conf"
    if [ -n "$PROFILE_PARSE_ERROR" ]; then
      echo "✗ Unsupported profile assignment in $conf: $PROFILE_PARSE_ERROR uses shell syntax. Only literal assignments are supported; rewrite it as a quoted literal or manage this profile manually outside the CLI/GUI." >&2
      return 64
    fi
    if [ "$PROFILE_EDITABLE" = true ]; then
      PROFILE_KIND="app"
    else
      PROFILE_KIND="manual"
    fi
  else
    echo "✗ SSH profile not found: $id ($conf)" >&2
    return 2
  fi

  PROFILE_LABEL="${SSH_PROFILE_LABEL:-$id}"
  SSH="${SSH_HOST:-user@your-ssh-host}"
  REMOTE_HOME="${SSH_REMOTE_HOME:-/home/user}"
  REMOTE_DIR="${SSH_REMOTE_DIR:-img-uploads}"

  if [ "$SSH" = "user@your-ssh-host" ]; then
    echo "✗ Not configured. Set SSH_HOST in $(profile_config_path "$id")." >&2
    notify "Not configured" "Set SSH_HOST for profile $id"
    return 2
  fi
  validate_loaded_profile || return $?
}

print_profile_row() (
  local id="$1" active="$2" marker=""
  load_profile "$id" || exit $?
  [ "$id" = "$active" ] && marker="*"
  printf '%s\t%s\t%s\t%s\n' "$marker" "$id" "$PROFILE_LABEL" "$SSH"
)

validate_selected_profile() (
  local id="$1"
  load_profile "$id" >/dev/null
)

list_profiles() {
  local active id
  active="$(read_active_profile)"
  if [ -n "$active" ]; then
    validate_selected_profile "$active"
  fi
  enumerate_profile_ids | while IFS= read -r id; do
    [ -n "$id" ] || continue
    print_profile_row "$id" "$active"
  done
}

is_symlink_path() { [ -L "$1" ]; }

refuse_mutation_symlinks() {
  local target="${1:-}"
  if is_symlink_path "$CONFIG_ROOT" || is_symlink_path "$PROFILES_DIR" || is_symlink_path "$ACTIVE_FILE" || { [ -n "$target" ] && is_symlink_path "$target"; }; then
    echo "✗ Refusing to mutate symlinked profile/config path" >&2
    return 73
  fi
  return 0
}

ensure_config_dirs() {
  refuse_mutation_symlinks "" || return $?
  umask 077
  mkdir -p "$CONFIG_ROOT" "$PROFILES_DIR" || return 73
  chmod 700 "$CONFIG_ROOT" "$PROFILES_DIR" 2>/dev/null || return 73
}

with_lock() {
  local lock="$CONFIG_ROOT/.lock" owner status old_exit old_int old_term old_hup
  ensure_config_dirs || return $?
  if [ -L "$lock" ]; then
    echo "✗ Refusing symlinked profile lock" >&2
    return 73
  fi
  if ! mkdir "$lock" 2>/dev/null; then
    if [ -L "$lock" ]; then
      echo "✗ Refusing symlinked profile lock" >&2
      return 73
    fi
    if [ -d "$lock" ] && [ ! -L "$lock" ]; then
      owner=""
      if [ -f "$lock/owner" ] && [ ! -L "$lock/owner" ]; then
        IFS= read -r owner < "$lock/owner" || true
      fi
      case "$owner" in
        ""|*[!0-9]*) ;;
        *)
          if kill -0 "$owner" 2>/dev/null; then
            echo "✗ Could not acquire profile lock" >&2
            return 73
          fi
          rm -f "$lock/owner" 2>/dev/null || true
          rmdir "$lock" 2>/dev/null || true
          ;;
      esac
    fi
    if ! mkdir "$lock" 2>/dev/null; then
      echo "✗ Could not acquire profile lock" >&2
      return 73
    fi
  fi
  printf '%s\n' "$$" > "$lock/owner" 2>/dev/null || { rmdir "$lock" 2>/dev/null || true; return 73; }
  _with_lock_cleanup() {
    if [ -d "$lock" ] && [ ! -L "$lock" ]; then
      if [ -f "$lock/owner" ] && [ ! -L "$lock/owner" ]; then
        rm -f "$lock/owner" 2>/dev/null || true
      fi
      rmdir "$lock" 2>/dev/null || true
    fi
  }
  old_exit="$(trap -p EXIT || true)"
  old_int="$(trap -p INT || true)"
  old_term="$(trap -p TERM || true)"
  old_hup="$(trap -p HUP || true)"
  trap '_with_lock_cleanup' EXIT
  trap '_with_lock_cleanup; exit 130' INT
  trap '_with_lock_cleanup; exit 143' TERM
  trap '_with_lock_cleanup; exit 129' HUP
  set +e
  "$@"
  status=$?
  set -e
  _with_lock_cleanup
  if [ -n "$old_exit" ]; then eval "$old_exit"; else trap - EXIT; fi
  if [ -n "$old_int" ]; then eval "$old_int"; else trap - INT; fi
  if [ -n "$old_term" ]; then eval "$old_term"; else trap - TERM; fi
  if [ -n "$old_hup" ]; then eval "$old_hup"; else trap - HUP; fi
  return "$status"
}

atomic_write_file() {
  local path="$1" content_file="$2" dir base tmp
  refuse_mutation_symlinks "$path" || return $?
  dir="$(dirname "$path")"
  base="$(basename "$path")"
  tmp="$(mktemp "$dir/.$base.tmp.XXXXXX")" || return 73
  umask 077
  cp "$content_file" "$tmp" || { rm -f "$tmp"; return 73; }
  chmod 600 "$tmp" || { rm -f "$tmp"; return 73; }
  mv "$tmp" "$path" || { rm -f "$tmp"; return 73; }
  chmod 600 "$path" 2>/dev/null || return 73
  return 0
}

atomic_write_string() {
  local path="$1" value="$2" tmpcontent
  tmpcontent="$(mktemp -t ssh-profile-content)" || return 73
  printf '%s' "$value" > "$tmpcontent" || { rm -f "$tmpcontent"; return 73; }
  atomic_write_file "$path" "$tmpcontent"
  local status=$?
  rm -f "$tmpcontent"
  return "$status"
}

shell_quote() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//\$/\\\$}"
  s="${s//\`/\\\`}"
  printf '"%s"' "$s"
}

write_profile_content_new() {
  local file="$1" label="$2" host="$3" home="$4" dir="$5" mode="$6" secs="$7"
  {
    printf '# ssh-img-paste profile v2\n'
    printf 'SSH_PROFILE_LABEL=%s\n' "$(shell_quote "$label")"
    printf 'SSH_HOST=%s\n' "$(shell_quote "$host")"
    printf 'SSH_REMOTE_HOME=%s\n' "$(shell_quote "$home")"
    printf 'SSH_REMOTE_DIR=%s\n' "$(shell_quote "$dir")"
    [ -z "$mode" ] || printf 'SSH_SHOT_MODE=%s\n' "$(shell_quote "$mode")"
    [ -z "$secs" ] || printf 'SSH_CLIP_RESTORE_SECONDS=%s\n' "$(shell_quote "$secs")"
  } > "$file"
}

FIELD_LABEL_SET=0
FIELD_HOST_SET=0
FIELD_HOME_SET=0
FIELD_DIR_SET=0
FIELD_MODE_SET=0
FIELD_SECS_SET=0
FIELD_LABEL=""
FIELD_HOST=""
FIELD_HOME=""
FIELD_DIR=""
FIELD_MODE=""
FIELD_SECS=""

reset_fields() {
  FIELD_LABEL_SET=0; FIELD_HOST_SET=0; FIELD_HOME_SET=0; FIELD_DIR_SET=0; FIELD_MODE_SET=0; FIELD_SECS_SET=0
  FIELD_LABEL=""; FIELD_HOST=""; FIELD_HOME=""; FIELD_DIR=""; FIELD_MODE=""; FIELD_SECS=""
}

parse_field_flags() {
  reset_fields
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --label) [ "$#" -ge 2 ] || die 64 "--label requires a value"; FIELD_LABEL="$2"; FIELD_LABEL_SET=1; shift 2 ;;
      --host) [ "$#" -ge 2 ] || die 64 "--host requires a value"; FIELD_HOST="$2"; FIELD_HOST_SET=1; shift 2 ;;
      --remote-home) [ "$#" -ge 2 ] || die 64 "--remote-home requires a value"; FIELD_HOME="$2"; FIELD_HOME_SET=1; shift 2 ;;
      --remote-dir) [ "$#" -ge 2 ] || die 64 "--remote-dir requires a value"; FIELD_DIR="$2"; FIELD_DIR_SET=1; shift 2 ;;
      --shot-mode) [ "$#" -ge 2 ] || die 64 "--shot-mode requires a value"; FIELD_MODE="$2"; FIELD_MODE_SET=1; shift 2 ;;
      --restore-seconds) [ "$#" -ge 2 ] || die 64 "--restore-seconds requires a value"; FIELD_SECS="$2"; FIELD_SECS_SET=1; shift 2 ;;
      *) die 64 "Unknown profile flag: $1" ;;
    esac
  done
  if [ "$FIELD_LABEL_SET" -eq 1 ]; then validate_label "$FIELD_LABEL" || exit $?; fi
  if [ "$FIELD_HOST_SET" -eq 1 ]; then validate_host "$FIELD_HOST" || exit $?; fi
  if [ "$FIELD_HOME_SET" -eq 1 ]; then validate_abs_path remote_home "$FIELD_HOME" || exit $?; fi
  if [ "$FIELD_DIR_SET" -eq 1 ]; then validate_remote_dir "$FIELD_DIR" || exit $?; fi
  if [ "$FIELD_MODE_SET" -eq 1 ]; then validate_shot_mode "$FIELD_MODE" || exit $?; fi
  if [ "$FIELD_SECS_SET" -eq 1 ]; then validate_restore_seconds "$FIELD_SECS" || exit $?; fi
}

require_create_fields() {
  [ "$FIELD_LABEL_SET" -eq 1 ] || die 64 "profile create requires --label"
  [ "$FIELD_HOST_SET" -eq 1 ] || die 64 "profile create requires --host"
  [ "$FIELD_HOME_SET" -eq 1 ] || die 64 "profile create requires --remote-home"
  [ "$FIELD_DIR_SET" -eq 1 ] || die 64 "profile create requires --remote-dir"
}

replace_or_append_profile_file() {
  local path="$1" out="$2" line key replaced_label=0 replaced_host=0 replaced_home=0 replaced_dir=0 replaced_mode=0 replaced_secs=0 value
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in *=*) key="${line%%=*}" ;; *) key="" ;; esac
    case "$key" in
      SSH_PROFILE_LABEL)
        if [ "$FIELD_LABEL_SET" -eq 1 ]; then printf 'SSH_PROFILE_LABEL=%s\n' "$(shell_quote "$FIELD_LABEL")"; replaced_label=1; else printf '%s\n' "$line"; fi ;;
      SSH_HOST)
        if [ "$FIELD_HOST_SET" -eq 1 ]; then printf 'SSH_HOST=%s\n' "$(shell_quote "$FIELD_HOST")"; replaced_host=1; else printf '%s\n' "$line"; fi ;;
      SSH_REMOTE_HOME)
        if [ "$FIELD_HOME_SET" -eq 1 ]; then printf 'SSH_REMOTE_HOME=%s\n' "$(shell_quote "$FIELD_HOME")"; replaced_home=1; else printf '%s\n' "$line"; fi ;;
      SSH_REMOTE_DIR)
        if [ "$FIELD_DIR_SET" -eq 1 ]; then printf 'SSH_REMOTE_DIR=%s\n' "$(shell_quote "$FIELD_DIR")"; replaced_dir=1; else printf '%s\n' "$line"; fi ;;
      SSH_SHOT_MODE)
        if [ "$FIELD_MODE_SET" -eq 1 ]; then printf 'SSH_SHOT_MODE=%s\n' "$(shell_quote "$FIELD_MODE")"; replaced_mode=1; else printf '%s\n' "$line"; fi ;;
      SSH_CLIP_RESTORE_SECONDS)
        if [ "$FIELD_SECS_SET" -eq 1 ]; then printf 'SSH_CLIP_RESTORE_SECONDS=%s\n' "$(shell_quote "$FIELD_SECS")"; replaced_secs=1; else printf '%s\n' "$line"; fi ;;
      *) printf '%s\n' "$line" ;;
    esac
  done < "$path" > "$out"
  if [ "$FIELD_LABEL_SET" -eq 1 ] && [ "$replaced_label" -eq 0 ]; then printf 'SSH_PROFILE_LABEL=%s\n' "$(shell_quote "$FIELD_LABEL")" >> "$out"; fi
  if [ "$FIELD_HOST_SET" -eq 1 ] && [ "$replaced_host" -eq 0 ]; then printf 'SSH_HOST=%s\n' "$(shell_quote "$FIELD_HOST")" >> "$out"; fi
  if [ "$FIELD_HOME_SET" -eq 1 ] && [ "$replaced_home" -eq 0 ]; then printf 'SSH_REMOTE_HOME=%s\n' "$(shell_quote "$FIELD_HOME")" >> "$out"; fi
  if [ "$FIELD_DIR_SET" -eq 1 ] && [ "$replaced_dir" -eq 0 ]; then printf 'SSH_REMOTE_DIR=%s\n' "$(shell_quote "$FIELD_DIR")" >> "$out"; fi
  if [ "$FIELD_MODE_SET" -eq 1 ] && [ "$replaced_mode" -eq 0 ]; then printf 'SSH_SHOT_MODE=%s\n' "$(shell_quote "$FIELD_MODE")" >> "$out"; fi
  if [ "$FIELD_SECS_SET" -eq 1 ] && [ "$replaced_secs" -eq 0 ]; then printf 'SSH_CLIP_RESTORE_SECONDS=%s\n' "$(shell_quote "$FIELD_SECS")" >> "$out"; fi
  value="$value" # quiet old shellcheck variants about all-local branch parsing
}

usable_profile_count() {
  local id count=0
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    if validate_selected_profile "$id" >/dev/null 2>&1; then
      count=$((count + 1))
    fi
  done <<EOF
$(enumerate_profile_ids)
EOF
  printf '%s\n' "$count"
}

cmd_profile_inspect() {
  local id="$1" active
  active="$(read_active_profile)"
  load_profile "$id" || exit $?
  printf 'id\t%s\n' "$id"
  printf 'label\t%s\n' "$PROFILE_LABEL"
  printf 'host\t%s\n' "$SSH"
  printf 'remote_home\t%s\n' "$REMOTE_HOME"
  printf 'remote_dir\t%s\n' "$REMOTE_DIR"
  printf 'shot_mode\t%s\n' "${SSH_SHOT_MODE:-region}"
  printf 'restore_seconds\t%s\n' "${SSH_CLIP_RESTORE_SECONDS:-60}"
  printf 'kind\t%s\n' "$PROFILE_KIND"
  printf 'path\t%s\n' "$PROFILE_PATH"
  printf 'editable\t%s\n' "$PROFILE_EDITABLE"
  if [ "$id" = "$active" ]; then printf 'active\ttrue\n'; else printf 'active\tfalse\n'; fi
}

_mutate_create() {
  local id="$1" path content was_active should_activate=0
  was_active="$(read_active_profile)"
  path="$PROFILES_DIR/$id.env"
  refuse_mutation_symlinks "$path" || return $?
  if profile_exists "$id"; then
    echo "✗ SSH profile already exists: $id" >&2
    return 64
  fi
  if [ -z "$was_active" ] || ! valid_profile_id "$was_active" || ! profile_exists "$was_active"; then
    should_activate=1
  fi
  content="$(mktemp -t ssh-profile-new)" || return 73
  write_profile_content_new "$content" "$FIELD_LABEL" "$FIELD_HOST" "$FIELD_HOME" "$FIELD_DIR" "$FIELD_MODE" "$FIELD_SECS"
  atomic_write_file "$path" "$content" || { rm -f "$content"; return 73; }
  rm -f "$content"
  if [ "$should_activate" -eq 1 ]; then
    if ! atomic_write_string "$ACTIVE_FILE" "$id
"; then
      rm -f "$path" 2>/dev/null || true
      return 73
    fi
  fi
  printf '✓ Created profile: %s\n' "$id"
}

cmd_profile_create() {
  local id="$1"
  shift
  validate_id_or_die "$id"
  parse_field_flags "$@"
  require_create_fields
  with_lock _mutate_create "$id"
}

_mutate_update() {
  local id="$1" path out
  load_profile "$id" || return $?
  path="$PROFILE_PATH"
  refuse_mutation_symlinks "$path" || return $?
  if [ "$PROFILE_EDITABLE" != true ]; then
    echo "✗ Profile is manually managed and cannot be rewritten by the GUI/CLI: $id" >&2
    return 77
  fi
  out="$(mktemp -t ssh-profile-update)" || return 73
  replace_or_append_profile_file "$path" "$out"
  atomic_write_file "$path" "$out" || { rm -f "$out"; return 73; }
  rm -f "$out"
  printf '✓ Updated profile: %s\n' "$id"
}

cmd_profile_update() {
  local id="$1"
  shift
  validate_id_or_die "$id"
  [ "$#" -gt 0 ] || die 64 "profile update requires at least one field flag"
  parse_field_flags "$@"
  with_lock _mutate_update "$id"
}

_mutate_rename() {
  local old="$1" new="$2" old_path new_path active
  active="$(read_active_profile)"
  load_profile "$old" || return $?
  old_path="$PROFILE_PATH"
  new_path="$PROFILES_DIR/$new.env"
  refuse_mutation_symlinks "$old_path" || return $?
  refuse_mutation_symlinks "$new_path" || return $?
  if profile_exists "$new"; then
    echo "✗ SSH profile already exists: $new" >&2
    return 64
  fi
  if [ "$active" = "$old" ]; then
    atomic_write_file "$new_path" "$old_path" || return 73
    chmod 600 "$new_path" 2>/dev/null || { rm -f "$new_path"; return 73; }
    atomic_write_string "$ACTIVE_FILE" "$new
" || { rm -f "$new_path"; return 73; }
    if ! rm -f "$old_path"; then
      echo "✗ Active profile switched to $new, but could not remove old profile: $old" >&2
      return 73
    fi
  else
    mv "$old_path" "$new_path" || return 73
    chmod 600 "$new_path" 2>/dev/null || return 73
  fi
  printf '✓ Renamed profile: %s → %s\n' "$old" "$new"
}

cmd_profile_rename() {
  local old="$1" new="$2"
  validate_id_or_die "$old"
  validate_id_or_die "$new"
  with_lock _mutate_rename "$old" "$new"
}

_mutate_use() {
  local id="$1"
  load_profile "$id" || return $?
  atomic_write_string "$ACTIVE_FILE" "$id
" || return 73
  printf '✓ Active SSH destination: %s (%s)\n' "$PROFILE_LABEL" "$SSH"
}

cmd_profile_use() {
  local id="$1"
  validate_id_or_die "$id"
  with_lock _mutate_use "$id"
}

_mutate_delete() {
  local id="$1" switch_to="$2" active count path
  active="$(read_active_profile)"
  count="$(usable_profile_count)"
  load_profile "$id" || return $?
  path="$PROFILE_PATH"
  refuse_mutation_symlinks "$path" || return $?
  if [ "$count" -le 1 ]; then
    echo "✗ Cannot delete the last usable profile" >&2
    return 64
  fi
  if [ "$active" = "$id" ]; then
    if [ -z "$switch_to" ]; then
      echo "✗ Deleting the active profile requires --switch-to OTHER" >&2
      return 64
    fi
    if [ "$switch_to" = "$id" ]; then
      echo "✗ --switch-to must name a different usable profile" >&2
      return 64
    fi
    load_profile "$switch_to" >/dev/null || return $?
    atomic_write_string "$ACTIVE_FILE" "$switch_to
" || return 73
  fi
  if ! rm -f "$path"; then
    if [ "$active" = "$id" ]; then
      echo "✗ Active profile switched to $switch_to, but could not delete profile: $id" >&2
    fi
    return 73
  fi
  printf '✓ Deleted profile: %s\n' "$id"
}

cmd_profile_delete() {
  local id="$1" switch_to=""
  shift
  validate_id_or_die "$id"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --switch-to) [ "$#" -ge 2 ] || die 64 "--switch-to requires a value"; switch_to="$2"; validate_id_or_die "$switch_to"; shift 2 ;;
      *) die 64 "Unknown profile delete flag: $1" ;;
    esac
  done
  with_lock _mutate_delete "$id" "$switch_to"
}

cmd_profile_test() {
  local id="$1"
  validate_id_or_die "$id"
  load_profile "$id" || exit $?
  if ssh -o BatchMode=yes -o ConnectTimeout=6 "$SSH" /usr/bin/true; then
    printf '✓ Connection OK: %s (%s)\n' "$PROFILE_LABEL" "$SSH"
    return 0
  fi
  echo "✗ Connection test failed: $PROFILE_LABEL ($SSH)" >&2
  return 75
}

if [ "${1:-}" = "--profile" ]; then
  [ "$#" -ge 2 ] || { usage; exit 64; }
  REQUESTED_PROFILE="$2"
  shift 2
fi

SELECTED_PROFILE="${REQUESTED_PROFILE:-$(read_active_profile)}"
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=6)

# Locate pngpaste across Homebrew prefixes / PATH (works on Apple Silicon + Intel).
if [ -z "${PNGPASTE:-}" ]; then
  for c in "$(command -v pngpaste 2>/dev/null || true)" /opt/homebrew/bin/pngpaste /usr/local/bin/pngpaste; do
    if [ -n "$c" ] && [ -x "$c" ]; then PNGPASTE="$c"; break; fi
  done
fi
PNGPASTE="${PNGPASTE:-/opt/homebrew/bin/pngpaste}"

# --- clipboard snapshot / restore (keeps the SSH path from lingering) --------
snapshot_clipboard() {
  local dir="$1"
  if osascript -e 'get the clipboard as «class PNGf»' >/dev/null 2>&1 && osascript >/dev/null 2>&1 <<OSA
set thePng to (the clipboard as «class PNGf»)
set f to (open for access (POSIX file "$dir/clip.png") with write permission)
write thePng to f
close access f
OSA
  then echo png; return; fi
  if pbpaste > "$dir/clip.txt" 2>/dev/null && [ -s "$dir/clip.txt" ]; then echo txt; return; fi
  echo none
}

restore_clipboard_after() {
  local secs="$1" expected="$2" type="$3" dir="$4"
  sleep "$secs"
  if [ "$(pbpaste 2>/dev/null || true)" = "$expected" ]; then
    case "$type" in
      png) osascript -e "set the clipboard to (read (POSIX file \"$dir/clip.png\") as «class PNGf»)" >/dev/null 2>&1 ;;
      txt) pbcopy < "$dir/clip.txt" ;;
      *)   printf '' | pbcopy ;;
    esac
  fi
  rm -rf "$dir"
}

# --- capture an image into $1; echo kind (clip|shot); non-zero if none/cancelled
acquire_image() {
  local out="$1" mode="$2"
  case "$mode" in
    clipboard)
      "$PNGPASTE" "$out" 2>/dev/null && { echo clip; return 0; }
      return 1 ;;
    region)
      screencapture -i -x -t png "$out" 2>/dev/null || true
      [ -s "$out" ] && { echo shot; return 0; }
      return 1 ;;   # user pressed Esc / no selection
    full)
      screencapture -x -t png "$out" 2>/dev/null || true
      [ -s "$out" ] && { echo shot; return 0; }
      return 1 ;;
    auto)
      if "$PNGPASTE" "$out" 2>/dev/null; then echo clip; return 0; fi
      acquire_image "$out" "${SSH_SHOT_MODE:-region}"; return $? ;;
  esac
}

# --- upload flow -------------------------------------------------------------
do_upload() {
  local mode="$1"
  local remote_root="$REMOTE_HOME/$REMOTE_DIR"
  local tmp; tmp="$(mktemp -t ssh-image-paste).png"
  trap 'rm -f "$tmp"' RETURN

  if { [ "$mode" = auto ] || [ "$mode" = clipboard ]; } && [ ! -x "$PNGPASTE" ]; then
    echo "✗ pngpaste not found at $PNGPASTE (brew install pngpaste)." >&2
    notify "Missing pngpaste" "Run: brew install pngpaste"
    return 3
  fi

  local kind
  if ! kind="$(acquire_image "$tmp" "$mode")"; then
    if [ "$mode" = region ] || [ "$mode" = full ]; then
      echo "· Screenshot cancelled." >&2       # Esc — not an error
      return 0
    fi
    echo "✗ No clipboard image, and screen capture failed/was cancelled." >&2
    echo "  Grant Screen Recording permission to SSH Image Paste, or copy an image first." >&2
    notify "No image" "Grant Screen Recording permission, or copy an image."
    return 1
  fi

  local name="$kind-$(date +%Y%m%d-%H%M%S).png"
  if ! scp -q "${SSH_OPTS[@]}" "$tmp" "$SSH:$remote_root/$name"; then
    ssh "${SSH_OPTS[@]}" "$SSH" "mkdir -p '$remote_root'" 2>/dev/null || true
    if ! scp -q "${SSH_OPTS[@]}" "$tmp" "$SSH:$remote_root/$name"; then
      notify "Upload failed" "Could not reach $PROFILE_LABEL ($SSH)."
      echo "✗ scp to $PROFILE_LABEL ($SSH) failed." >&2
      return 4
    fi
  fi

  local remote_path="$remote_root/$name"
  local grace="${SSH_CLIP_RESTORE_SECONDS:-60}"
  local snapdir; snapdir="$(mktemp -d -t sshclip)"
  local snaptype; snaptype="$(snapshot_clipboard "$snapdir")"
  printf '%s' "$remote_path" | pbcopy
  if [ "$grace" -gt 0 ] 2>/dev/null; then
    restore_clipboard_after "$grace" "$remote_path" "$snaptype" "$snapdir" >/dev/null 2>&1 </dev/null &
    disown 2>/dev/null || true
  else
    rm -rf "$snapdir"
  fi

  local label; label=$([ "$kind" = shot ] && echo "Screenshot" || echo "Image")
  echo "✓ Uploaded ($label) → $remote_path [$PROFILE_LABEL]"
  echo "  Path is on your clipboard — Cmd+V it into your SSH session and send."
  notify "$label path copied — $PROFILE_LABEL" "clipboard restores in ${grace}s"
}

# --- dispatch ----------------------------------------------------------------
case "${1:-upload}" in
  profiles)
    list_profiles
    ;;
  profile)
    case "${2:-current}" in
      current)
        validate_selected_profile "$SELECTED_PROFILE"
        printf '%s\n' "$SELECTED_PROFILE"
        ;;
      use)
        [ "$#" -eq 3 ] || { profile_usage; exit 64; }
        cmd_profile_use "$3"
        ;;
      inspect)
        [ "$#" -eq 3 ] || { profile_usage; exit 64; }
        cmd_profile_inspect "$3"
        ;;
      create)
        [ "$#" -ge 4 ] || { profile_usage; exit 64; }
        id="$3"; shift 3
        cmd_profile_create "$id" "$@"
        ;;
      update)
        [ "$#" -ge 4 ] || { profile_usage; exit 64; }
        id="$3"; shift 3
        cmd_profile_update "$id" "$@"
        ;;
      rename)
        [ "$#" -eq 4 ] || { profile_usage; exit 64; }
        cmd_profile_rename "$3" "$4"
        ;;
      delete)
        [ "$#" -ge 3 ] || { profile_usage; exit 64; }
        id="$3"; shift 3
        cmd_profile_delete "$id" "$@"
        ;;
      test)
        [ "$#" -eq 3 ] || { profile_usage; exit 64; }
        cmd_profile_test "$3"
        ;;
      *)
        profile_usage
        exit 64
        ;;
    esac
    ;;
  upload)
    load_profile "$SELECTED_PROFILE"
    do_upload auto
    ;;
  region)
    load_profile "$SELECTED_PROFILE"
    do_upload region
    ;;
  full)
    load_profile "$SELECTED_PROFILE"
    do_upload full
    ;;
  list)
    load_profile "$SELECTED_PROFILE"
    remote_root="$REMOTE_HOME/$REMOTE_DIR"
    ssh "${SSH_OPTS[@]}" "$SSH" \
      "mkdir -p '$remote_root' && find '$remote_root' -maxdepth 1 -type f -name '*.png' -printf '%T@\t%s\t%f\n' | sort -rn | cut -f2-"
    ;;
  fetch)
    [ "$#" -eq 2 ] || { usage; exit 64; }
    name="$2"
    validate_fetch_name "$name" || exit $?
    load_profile "$SELECTED_PROFILE"
    remote_root="$REMOTE_HOME/$REMOTE_DIR"
    dest="$(mktemp -d -t ssh-image-paste)/$name"
    scp -q "${SSH_OPTS[@]}" "$SSH:$remote_root/$name" "$dest"
    echo "$dest"
    ;;
  clean)
    load_profile "$SELECTED_PROFILE"
    remote_root="$REMOTE_HOME/$REMOTE_DIR"
    n="$(ssh "${SSH_OPTS[@]}" "$SSH" \
      "find '$remote_root' -maxdepth 1 -type f -name '*.png' -printf '.' -delete 2>/dev/null | wc -c" | tr -d ' ')"
    echo "✓ Deleted ${n:-0} uploaded image(s) on $PROFILE_LABEL ($SSH)."
    notify "Uploads cleaned — $PROFILE_LABEL" "Deleted ${n:-0} image(s) on the SSH host."
    ;;
  *)
    usage
    exit 64
    ;;
esac
