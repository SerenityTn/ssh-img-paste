<Project Sdk="Microsoft.NET.Sdk">
  <!-- Regenerates SSHImagePaste.Windows/Assets and packaging/msix/Assets from IconFactory. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\SSHImagePaste.Windows\Imaging\IconFactory.cs" Link="IconFactory.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- WPF and Windows Forms share type names; import Forms/Drawing explicitly where used. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
