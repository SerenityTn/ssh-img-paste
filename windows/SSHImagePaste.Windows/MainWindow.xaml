<Window x:Class="SSHImagePaste.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH Image Paste" Width="500" SizeToContent="Height"
        MinWidth="440" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/AppIcon.ico">
    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="{x:Static ApplicationCommands.Paste}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Paste}" Executed="Paste_Executed" />
    </Window.CommandBindings>
    <StackPanel Margin="24,20,24,18">
        <DockPanel Margin="0,0,0,18" LastChildFill="True">
            <Image x:Name="AppImage" Width="44" Height="44" Margin="0,0,14,0" DockPanel.Dock="Left"
                   AutomationProperties.Name="SSH Image Paste icon" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SSH Image Paste" FontSize="22" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0"
                           Text="Upload an image, then paste its remote path into your SSH session." />
            </StackPanel>
        </DockPanel>

        <TextBlock Text="Destination" Style="{StaticResource SectionHeading}" />
        <DockPanel Margin="0,0,0,18">
            <Button x:Name="ManageButton" Content="_Manage…" DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="96"
                    Click="Manage_Click" AutomationProperties.Name="Manage profiles" />
            <ComboBox x:Name="DestinationBox" SelectionChanged="Destination_SelectionChanged"
                      AutomationProperties.Name="Active destination">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Host}" Margin="10,0,0,0" Opacity="0.65" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <Button x:Name="UploadButton" Height="48" Margin="0,0,0,10" Click="Upload_Click"
                Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                AutomationProperties.Name="Upload clipboard image"
                AutomationProperties.HelpText="Uploads the clipboard image, or captures a screenshot when the clipboard has no image. Shortcut: Control plus V.">
            <StackPanel Orientation="Horizontal">
                <AccessText Text="_Upload clipboard image" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="Ctrl+V" Margin="12,0,0,0" Opacity="0.75" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="10" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button x:Name="RegionButton" Grid.Column="0" Height="40" Content="Capture _region"
                    HorizontalAlignment="Stretch" Click="Region_Click" AutomationProperties.Name="Capture region" />
            <Button x:Name="FullButton" Grid.Column="2" Height="40" Content="Capture _full screen"
                    HorizontalAlignment="Stretch" Click="Full_Click" AutomationProperties.Name="Capture full screen" />
        </Grid>
        <Button x:Name="UploadsButton" Height="40" Content="Uploaded _images…" HorizontalAlignment="Stretch"
                Click="Uploads_Click" AutomationProperties.Name="Uploaded images" />

        <Border x:Name="StatusCard" Margin="0,18,0,0" Padding="14,12" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <StackPanel>
                <DockPanel>
                    <Image x:Name="StatusImage" Width="20" Height="20" Margin="0,0,10,0" DockPanel.Dock="Left"
                           VerticalAlignment="Top" />
                    <TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap"
                               AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
                <DockPanel x:Name="PathPanel" Margin="30,10,0,0" Visibility="Collapsed">
                    <Button Content="_Copy" DockPanel.Dock="Right" Margin="8,0,0,0" MinWidth="72" Click="CopyPath_Click"
                            AutomationProperties.Name="Copy remote path" />
                    <TextBox x:Name="PathBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"
                             AutomationProperties.Name="Last remote path" />
                </DockPanel>
            </StackPanel>
        </Border>

        <DockPanel Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource SecondaryText}"
                       VerticalAlignment="Center" FontSize="12">
                <Hyperlink Click="OpenLogs_Click">Logs</Hyperlink>
                <Run x:Name="VersionRun" />
            </TextBlock>
            <CheckBox x:Name="StartupCheck" Content="Start when I sign in" Checked="Startup_Changed" Unchecked="Startup_Changed"
                      AutomationProperties.Name="Start SSH Image Paste when I sign in" />
        </DockPanel>
    </StackPanel>
</Window>
