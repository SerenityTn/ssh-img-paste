<Window x:Class="SSHImagePaste.Windows.UploadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uploaded Images — SSH Image Paste" Width="760" Height="520"
        MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/AppIcon.ico">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button x:Name="RefreshButton" Content="_Refresh" DockPanel.Dock="Right" MinWidth="96" Margin="8,0,0,0"
                    Click="Refresh_Click" />
            <TextBlock Text="Destination" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
            <ComboBox x:Name="DestinationBox" SelectionChanged="Destination_SelectionChanged"
                      AutomationProperties.Name="Destination to list">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RemoteRoot}" Margin="10,0,0,0" Opacity="0.65" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button x:Name="CleanButton" Content="Delete _all uploads…" DockPanel.Dock="Right" MinWidth="150"
                    Click="Clean_Click" AutomationProperties.HelpText="Deletes every PNG in this destination's upload folder." />
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OpenButton" Content="_Open" MinWidth="88" Click="Open_Click"
                        Style="{DynamicResource AccentButtonStyle}" AutomationProperties.HelpText="Downloads the image and opens it." />
                <Button x:Name="CopyButton" Content="_Copy remote path" MinWidth="140" Margin="8,0,0,0" Click="Copy_Click" />
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,10,0,0" TextWrapping="Wrap"
                   AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" />

        <ListView x:Name="UploadList" SelectionMode="Single" MouseDoubleClick="UploadList_MouseDoubleClick"
                  SelectionChanged="UploadList_SelectionChanged" AutomationProperties.Name="Uploaded images">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="330" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding Size}" />
                    <GridViewColumn Header="Uploaded" Width="200" DisplayMemberBinding="{Binding Modified}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
