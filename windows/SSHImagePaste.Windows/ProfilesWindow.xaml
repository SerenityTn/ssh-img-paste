<Window x:Class="SSHImagePaste.Windows.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Profiles — SSH Image Paste" Width="820" Height="520"
        MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/AppIcon.ico">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0" Grid.Row="0">
            <TextBlock DockPanel.Dock="Top" Text="Destinations" Style="{StaticResource SectionHeading}" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="AddButton"  MinWidth="88" Click="Add_Click"
                        Style="{DynamicResource AccentButtonStyle}" AutomationProperties.Name="Add destination">
                    <AccessText Text="_Add…" />
                </Button>
                <Button x:Name="DuplicateButton" Content="D_uplicate…" MinWidth="96" Margin="8,0,0,0" Click="Duplicate_Click"
                        AutomationProperties.Name="Duplicate destination" />
            </StackPanel>
            <ListBox x:Name="ProfileList" SelectionChanged="ProfileList_SelectionChanged"
                     MouseDoubleClick="ProfileList_MouseDoubleClick"
                     AutomationProperties.Name="Destinations">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Badge}" Margin="8,0,0,0" Opacity="0.75" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Subtitle}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Grid x:Name="EmptyPanel" Grid.Column="2" Grid.Row="0" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" MaxWidth="420">
                <TextBlock Text="Add your first SSH destination" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                           Text="SSH Image Paste uses the OpenSSH client built into Windows and your existing SSH configuration. Keys, ports, users, and jump hosts stay in your SSH config, and this app never stores passwords." />
                <TextBlock Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                           Text="Before adding a destination, make sure ssh &lt;host&gt; works in a terminal without asking for a password or passphrase." />
                <Button  HorizontalAlignment="Left" Margin="0,16,0,0" MinWidth="160" Height="36"
                        Style="{DynamicResource AccentButtonStyle}" Click="Add_Click">
                    <AccessText Text="_Add destination…" />
                </Button>
            </StackPanel>
        </Grid>

        <DockPanel x:Name="DetailPanel" Grid.Column="2" Grid.Row="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           AutomationProperties.HeadingLevel="Level2" />
                <TextBlock x:Name="DetailBadge" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
            </StackPanel>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <Button x:Name="UseButton" Content="_Set active" MinWidth="96" Margin="0,0,8,8" Click="Use_Click" />
                <Button x:Name="TestButton" Content="_Test connection" MinWidth="128" Margin="0,0,8,8" Click="Test_Click" />
                <Button x:Name="EditButton" Content="_Edit…" MinWidth="80" Margin="0,0,8,8" Click="Edit_Click" />
                <Button x:Name="RenameButton" Content="Re_name…" MinWidth="88" Margin="0,0,8,8" Click="Rename_Click" />
                <Button x:Name="DeleteButton" Content="_Delete…" MinWidth="88" Margin="0,0,8,8" Click="Delete_Click" />
            </WrapPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                <Grid x:Name="DetailGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>
        </DockPanel>

        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0" Padding="12,10" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Destinations are stored as literal profile files and are never executed."
                       AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</Window>
